# Copy to .env and fill in real values. Never commit .env.

# ---------- Database: Turso (libSQL) ----------

# Remote Turso database. Created with:
#   turso db create budgetms
#   turso db tokens create --db budgetms     # paste the token below
TURSO_DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN=""

# Short database name, used by `npm run db:deploy` to apply migrations.
TURSO_DATABASE_NAME="budgetms"

# Local development only. The libSQL driver also reads plain SQLite files, so
# `file:./dev.db` works for `npm run dev` with no remote database. Relative
# paths are resolved against prisma/ (matching `prisma db push`), so this
# points at prisma/dev.db. Ignored whenever TURSO_DATABASE_URL is set.
DATABASE_URL="file:./dev.db"

# ---------- Required in production ----------

# 32+ byte random secret for JWT session signing.
# Generate with: openssl rand -base64 32
# The app throws at boot in production if this is missing or too short.
AUTH_SECRET=""

# Public base URL of the deployment. Used for password-reset links.
APP_URL="http://localhost:3000"

# ---------- Optional ----------

# Email (password reset links are logged to the server when unconfigured)
# EMAIL_SERVER=
# EMAIL_FROM="noreply@example.com"

# Storage (transaction attachments are stored as URL strings)
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Budget control thresholds (percent of allocation)
BUDGET_WARNING_THRESHOLD="80"
BUDGET_CRITICAL_THRESHOLD="90"

# ---------- Seed credentials ----------
# Only used by `npm run db:seed`. Set real, strong values before seeding a
# production database, then unset them. In production the seed refuses to run
# unless every value is set and passwords are at least 12 characters.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
