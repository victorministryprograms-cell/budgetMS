# Copy to .env and fill in real values. Never commit .env.

# ---------- Required in production ----------

# PostgreSQL connection string. The app targets Postgres (serverless hosts have
# no persistent filesystem, so SQLite is not supported in production).
#   Vercel Postgres / Neon:  postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#   Local dev:               postgresql://postgres:postgres@localhost:5432/budgetms
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/budgetms?sslmode=require"

# 32+ byte random secret for JWT session signing.
# Generate with: openssl rand -base64 32
# Required: the app throws at boot in production if this is missing or too short.
AUTH_SECRET=""

# Public base URL of the deployment. Used for password-reset links.
APP_URL="http://localhost:3000"

# ---------- Optional ----------

# Email (password reset links are logged to the server when unconfigured)
# EMAIL_SERVER=
# EMAIL_FROM="noreply@example.com"

# Storage (transaction attachments are stored as URL strings)
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# Budget control thresholds (percent of allocation)
BUDGET_WARNING_THRESHOLD="80"
BUDGET_CRITICAL_THRESHOLD="90"

# ---------- Seed credentials ----------
# Only used by `npm run db:seed`. Set real, strong values before seeding a
# production database, then unset them. Never reuse the values below.
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
